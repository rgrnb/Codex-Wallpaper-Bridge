{
  "name": "codex-wallpaper-bridge",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Independent Wallpaper Engine library and continuous Codex window backgrounds for Windows",
  "engines": { "node": ">=22.15" },
  "scripts": {
    "start": "node src/main.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:visual": "node scripts/visual-acceptance.mjs",
    "test:manager": "powershell.exe -NoProfile -STA -File scripts/manager-ui-smoke.ps1",
    "test:independent": "node scripts/independent-acceptance.mjs",
    "test:library": "node scripts/library-acceptance.mjs",
    "test:renderer-lifecycle": "node scripts/renderer-lifecycle-acceptance.mjs",
    "test:uninstall": "powershell.exe -NoProfile -File scripts/uninstall-smoke.ps1",
    "test:native": "node scripts/native-smoke.mjs",
    "test:service": "node scripts/service-smoke.mjs",
    "test:current-video": "node scripts/current-video-smoke.mjs",
    "test:shared-video": "node scripts/shared-video-smoke.mjs",
    "test:web": "node scripts/web-backend-smoke.mjs",
    "test:application": "node scripts/application-backend-smoke.mjs",
    "test:graphics": "node scripts/graphics-backend-smoke.mjs",
    "test:scene": "node scripts/scene-backend-smoke.mjs",
    "test:codex": "node scripts/codex-acceptance-smoke.mjs",
    "test:managed-launch": "node scripts/managed-launch-smoke.mjs",
    "test:install-update": "node scripts/install-update-smoke.mjs",
    "build": "powershell.exe -NoProfile -File scripts/build.ps1",
    "probe": "node src/main.mjs --probe"
  }
}
